class Pony < Formula
  desc "Talk to your OnePony ponies from the terminal"
  homepage "https://www.onepony.com"
  license "MIT"

  # Prebuilt kegs from the release. Pouring one skips Homebrew's
  # build-from-source checks, so no Command Line Tools are needed.
  bottle do
    root_url "@BASE@"
    sha256 cellar: :any_skip_relocation, arm64_big_sur: "@BOTTLE_ARM64_BIG_SUR@"
    sha256 cellar: :any_skip_relocation, big_sur:       "@BOTTLE_BIG_SUR@"
    sha256 cellar: :any_skip_relocation, arm64_linux:   "@BOTTLE_ARM64_LINUX@"
    sha256 cellar: :any_skip_relocation, x86_64_linux:  "@BOTTLE_X86_64_LINUX@"
  end

  on_macos do
    on_arm do
      url "@BASE@/pony_@VERSION@_darwin_arm64.tar.gz"
      sha256 "@SHA_DARWIN_ARM64@"
    end
    on_intel do
      url "@BASE@/pony_@VERSION@_darwin_amd64.tar.gz"
      sha256 "@SHA_DARWIN_AMD64@"
    end
  end

  on_linux do
    on_arm do
      url "@BASE@/pony_@VERSION@_linux_arm64.tar.gz"
      sha256 "@SHA_LINUX_ARM64@"
    end
    on_intel do
      url "@BASE@/pony_@VERSION@_linux_amd64.tar.gz"
      sha256 "@SHA_LINUX_AMD64@"
    end
  end

  def install
    bin.install "pony"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/pony version")
  end
end
